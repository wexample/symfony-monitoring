{
  "name": "wexample/symfony-monitoring",
  "description": "Incidents followed until someone deals with them — opened by what reports them, the remotes first, closed by hand or when the cause goes away — and heartbeats for what must keep running",
  "version": "1.0.1",
  "type": "library",
  "license": "MIT",
  "autoload": {
    "psr-4": {
      "Wexample\\SymfonyMonitoring\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Wexample\\SymfonyMonitoring\\Tests\\": "tests/"
    }
  },
  "authors": [
    {
      "name": "weeger",
      "email": "romain.weeger@wexample.com"
    }
  ],
  "require": {
    "php": ">=8.5",
    "doctrine/orm": "^3.0",
    "doctrine/doctrine-bundle": "^2.13 || ^3.0",
    "symfony/console": "^7.4 || ^8.0",
    "symfony/event-dispatcher": "^7.4 || ^8.0",
    "symfony/scheduler": "^7.4 || ^8.0",
    "symfony/uid": "^7.4 || ^8.0",
    "wexample/php-remote": ">=3.0.0",
    "wexample/symfony-check": ">=4.0.8",
    "wexample/symfony-helpers": ">=19.3.0",
    "wexample/symfony-notification": ">=2.2.1",
    "wexample/symfony-user": ">=23.0.0"
  },
  "require-dev": {
    "phpunit/phpunit": "^13"
  },
  "suggest": {
    "wexample/symfony-activity": "To keep each change of an incident's status in its history.",
    "wexample/symfony-monitoring-ds": "The screens: the incidents, their decisions, the heartbeats."
  },
  "repositories": [
    {
      "type": "path",
      "url": "../*",
      "options": {
        "symlink": true
      }
    }
  ],
  "extra": {
    "install": {
      "bundle_env": "all"
    }
  }
}
